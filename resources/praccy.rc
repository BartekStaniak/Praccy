// Praccy Windows Resource Script
#include <windows.h>
#include "resource.h"

// Application Icons
IDI_APP_ICON            ICON    "icon.ico"
1                       ICON    "icon.ico"

// Embedded TrueType Fonts (RT_RCDATA / type 10)
IDR_FONT_INTER          RCDATA  "fonts/Inter-Regular.ttf"
IDR_FONT_JETBRAINS_MONO RCDATA  "fonts/JetBrainsMono-Regular.ttf"

// Application Version & Metadata
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,5,0,0
PRODUCTVERSION  2,5,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Praccy Audio"
            VALUE "FileDescription",  "Praccy - ASIO VST3 & CLAP Practice Suite"
            VALUE "FileVersion",      "2.5-beta3"
            VALUE "InternalName",     "Praccy"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Bartek Staniak"
            VALUE "OriginalFilename", "Praccy.exe"
            VALUE "ProductName",      "Praccy"
            VALUE "ProductVersion",   "2.5-beta3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
